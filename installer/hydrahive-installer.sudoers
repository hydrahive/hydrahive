# WhatsApp Bridge Restart
hydrahive ALL=(root) NOPASSWD: /bin/systemctl restart hydrahive-whatsapp-bridge

# Tailscale
hydrahive ALL=(root) NOPASSWD: /usr/bin/tailscale up --authkey *
hydrahive ALL=(root) NOPASSWD: /usr/bin/tailscale down

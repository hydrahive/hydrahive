hydrahive ALL=(root) NOPASSWD: /bin/bash /opt/hydrahive/installer/extensions/uninstall/plex.sh
hydrahive ALL=(root) NOPASSWD: /bin/bash /opt/hydrahive/installer/extensions/install/radarr.sh

[Unit]
Description=HydraHive A-MEM Search UI
After=network.target hydrahive-amem.service
Wants=hydrahive-amem.service

[Service]
Type=simple
User=hydrahive
Group=hydrahive
WorkingDirectory=/opt/amem-search
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/amem/.venv/bin/python /opt/amem-search/search_ui.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

[Unit]
Description=OctopOS A-MEM MCP Server
After=network.target ollama.service
Wants=ollama.service

[Service]
Type=simple
User=octopos
Group=octopos
WorkingDirectory=/opt/amem
EnvironmentFile=/etc/octopos/amem.env
ExecStart=/opt/amem/.venv/bin/python /opt/amem/amem_mcp_server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
